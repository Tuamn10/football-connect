DATABASE_URL=postgresql://postgres:your_password@localhost:5432/football_connect
SECRET_KEY=your-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ASSISTANT_PROVIDER=gemini
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ASSISTANT_MODEL=gemini-2.5-flash
ASSISTANT_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Football Connect
SMTP_USE_TLS=true

PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_DEBUG=true
ASSISTANT_TIMEOUT=15